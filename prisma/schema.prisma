// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Shopify session storage (required by @shopify/shopify-app-session-storage-prisma) ---
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// --- Our app's data, one row per installed shop ---
model ShopSettings {
  id            String    @id @default(cuid())
  shop          String    @unique
  companyName   String?
  vatRegistered Boolean   @default(false)
  vatNumber     String?
  // Not used by any logic yet — capturing early so EU expansion (PLAN.md
  // Section 5a) doesn't need a backfill once it's actually built. country
  // is the merchant's home country (ISO 3166-1 alpha-2, e.g. "GB", "ES");
  // homeCurrency is their base currency (ISO 4217, e.g. "GBP", "EUR").
  country       String?
  homeCurrency  String?
  backfilledAt  DateTime? // set once the one-time historical order backfill has run
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Order {
  id             String    @id @default(cuid())
  shop           String
  shopifyOrderId String
  name           String
  status         String?
  paidAt         DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  email          String?
  subtotal       Float     @default(0)
  shipping       Float     @default(0)
  taxes          Float     @default(0)
  total          Float     @default(0)
  refundedAmount Float     @default(0)
  currency       String    @default("GBP")

  lineItems    OrderLineItem[]
  awOrderCosts AwOrderCost[]

  @@unique([shop, shopifyOrderId])
  @@index([shop])
  @@index([shop, paidAt])
}

model OrderLineItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku     String?
  name    String
  qty     Int    @default(1)
  price   Float  @default(0)
  vendor  String?

  @@index([orderId])
}

// --- AW's own order-level cost ledger (bulk CSV/xlsx export from the AW portal).
// This is the PRIMARY cost source feeding P&L/VAT/Dashboard — see PLAN.md.
// `orderId` links to our own Order once the ledger row's FulfillmentOrder GID is
// resolved via the Admin API (see app/lib/fulfillmentResolve.server.ts). A row can
// be saved with orderId still null (e.g. uploaded before the order has synced from
// Shopify yet) — it still counts toward aggregate totals; the link is only needed
// for the per-order margin shown on the Sales page.
model AwOrderCost {
  id                  String    @id @default(cuid())
  shop                String
  reference           String // AW's own order reference, e.g. "AWD187818"
  fulfillmentOrderGid String? // "gid://shopify/FulfillmentOrder/..." from the export
  orderId             String?
  order               Order?    @relation(fields: [orderId], references: [id])
  clientName          String? // end customer name — kept as a fallback if GID resolution fails
  date                DateTime?
  status              String? // "In Warehouse" | "Dispatched" | "Cancelled" | ...
  itemsCount          Int?
  currency            String?
  goods               Float?
  charges             Float?
  chargesDetail       String?
  shipping            Float?
  insurance           Float?
  net                 Float?
  tax                 Float?
  total               Float?
  paid                Float?
  createdAt           DateTime  @default(now())

  @@unique([shop, reference])
  @@index([shop])
  @@index([shop, date])
  @@index([orderId])
}

// --- AW invoice PDFs — OPTIONAL supplementary record, not summed into P&L/VAT
// totals (AwOrderCost above is the source of truth, to avoid double-counting the
// same order's cost from two documents). Kept for two things AwOrderCost doesn't
// have: the formal invoice number for a real VAT audit trail, and product-level
// line items (SKU code, description) for future SKU-margin BI. See PLAN.md 5b.
model SupplierInvoice {
  id                String    @id @default(cuid())
  shop              String
  docNumber         String
  type              String // "invoice" | "refund"
  date              DateTime?
  originalInvoice   String?
  paymentState      String?
  deliveryCountry   String?
  totalNet          Float?
  shipping          Float?
  charges           Float?
  vat               Float?
  total             Float?
  outsideScopeOfTax Boolean   @default(false)
  createdAt         DateTime  @default(now())

  lineItems SupplierInvoiceLineItem[]

  @@unique([shop, docNumber])
  @@index([shop])
  @@index([shop, date])
}

model SupplierInvoiceLineItem {
  id        String          @id @default(cuid())
  invoiceId String
  invoice   SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  code      String
  desc      String
  price     Float
  qty       Int
  amount    Float

  @@index([invoiceId])
}
