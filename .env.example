# Copy to .env for local dev. Shopify CLI fills in most of these automatically
# when you run `shopify app dev` after linking a real app (see README.md).

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_orders
SHOPIFY_APP_URL=

# Railway Postgres connection string (Railway sets this for you automatically
# once you add the Postgres plugin to this project — copy it from the
# Postgres service's "Connect" tab into this project's service variables).
DATABASE_URL=

NODE_ENV=development
